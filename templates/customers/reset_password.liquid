<section class="auth-page has-bottom-tabs">
  <div class="auth-page__card postcard postcard--soft">
    <div class="h-kicker">RESET</div>
    <h1>New password</h1>
    <p class="sub">Set a new password for your Gharana account.</p>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <div style="padding:10px 12px;background:#F8E3DC;border:1px solid var(--color-error);color:var(--color-error);border-radius:10px;margin-bottom:14px;font-size:12.5px;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
      <div class="form-field"><label for="pw">New password</label><input type="password" id="pw" name="customer[password]" required></div>
      <div class="form-field"><label for="pw2">Confirm password</label><input type="password" id="pw2" name="customer[password_confirmation]" required></div>
      <div class="form-actions"><button type="submit">Reset password</button></div>
    {%- endform -%}
  </div>
</section>
