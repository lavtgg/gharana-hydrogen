<section class="auth-page has-bottom-tabs">
  <div class="auth-page__card postcard postcard--soft">
    <div class="h-kicker">ACTIVATE</div>
    <h1>Set your password</h1>
    <p class="sub">Activate your Gharana account by setting a password.</p>
    {%- form 'activate_customer_password' -%}
      {%- if form.errors -%}
        <div style="padding:10px 12px;background:#F8E3DC;border:1px solid var(--color-error);color:var(--color-error);border-radius:10px;margin-bottom:14px;font-size:12.5px;">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="form-field"><label for="actpw">Password</label><input type="password" id="actpw" name="customer[password]" required></div>
      <div class="form-field"><label for="actpw2">Confirm password</label><input type="password" id="actpw2" name="customer[password_confirmation]" required></div>
      <div class="form-actions"><button type="submit">Activate account</button></div>
    {%- endform -%}
  </div>
</section>
