<section class="auth-page has-bottom-tabs">
  <div class="auth-page__card postcard postcard--soft">
    <div class="h-kicker">GHARANA</div>
    <h1>Welcome back</h1>
    <p class="sub">Sign in to reorder your pantry staples in one tap.</p>

    {%- form 'customer_login', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div style="padding:10px 12px;background:#F8E3DC;border:1px solid var(--color-error);color:var(--color-error);border-radius:10px;margin-bottom:14px;font-size:12.5px;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
      <div class="form-field">
        <label for="CustomerEmail">Email</label>
        <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" autocapitalize="off" required>
      </div>
      <div class="form-field">
        <label for="CustomerPassword">Password</label>
        <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password" required>
      </div>
      <div class="form-actions">
        <button type="submit">Sign in</button>
      </div>
      <div class="form-note">
        <a href="#recover" onclick="document.getElementById('recover-form').style.display='block';return false;">Forgot your password?</a>
      </div>
      <div class="form-note" style="margin-top:16px;">
        New to Gharana? <a href="{{ routes.account_register_url }}">Create an account</a>
      </div>
    {%- endform -%}

    <div id="recover-form" style="display:none;margin-top:20px;padding-top:20px;border-top:1px dashed var(--color-hairline);">
      <div class="h-kicker" style="margin-bottom:6px;">RESET</div>
      <h2 style="font-family:var(--font-heading);font-size:20px;font-weight:600;margin-bottom:6px;">Reset your password</h2>
      <p class="sub">We’ll email you a reset link.</p>
      {%- form 'recover_customer_password' -%}
        <div class="form-field">
          <label for="RecoverEmail">Email</label>
          <input type="email" id="RecoverEmail" name="email" autocomplete="email" required>
        </div>
        <div class="form-actions">
          <button type="submit">Send reset link</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>
