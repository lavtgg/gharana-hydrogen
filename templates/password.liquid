<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ shop.name }} — Coming soon</title>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <style>
      body { display:grid; place-items:center; min-height:100vh; padding:40px 20px; }
      .password-card { max-width: 480px; text-align:center; }
      .password-card h1 { font-family: var(--font-heading); font-size:36px; color:var(--color-earth); margin-bottom:8px; }
      .password-card p { color:var(--color-espresso); margin-bottom:20px; }
      .password-card form input { width:100%; padding:14px; border:1.5px solid var(--color-hairline); background:var(--color-paper); border-radius:10px; margin-bottom:10px; }
      .password-card form button { width:100%; padding:14px; background:var(--color-saffron); color:#fff; font-weight:800; border-radius:10px; }
    </style>
  </head>
  <body>
    <div class="postcard postcard--soft password-card" style="padding:32px;">
      <div class="h-kicker">GHARANA</div>
      <h1>{{ shop.name }}</h1>
      <p>{{ shop.password_message | default: 'A traditional pantry, coming soon.' }}</p>
      {%- form 'storefront_password' -%}
        <input type="password" name="password" placeholder="Enter store password" required>
        {%- if form.errors -%}
          <div style="color:var(--color-error);font-size:12px;margin-bottom:8px;">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <button type="submit">Enter</button>
      {%- endform -%}
    </div>
  </body>
</html>
