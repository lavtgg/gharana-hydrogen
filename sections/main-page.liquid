<section class="container-block has-bottom-tabs" style="padding:20px 0;">
  <div class="page-width">
    <article class="postcard postcard--soft" style="padding:28px;">
      <div class="h-kicker">GHARANA</div>
      <h1 style="font-family:var(--font-heading);font-size:30px;font-weight:700;margin:6px 0 14px;">{{ page.title }}</h1>
      <div class="rte" style="font-size:14px;line-height:1.7;color:var(--color-espresso);">{{ page.content }}</div>
    </article>
  </div>
</section>

