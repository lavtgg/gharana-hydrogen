<section class="section container-block" style="padding:0;">
  <div class="promo-scroll">
    {%- for block in section.blocks -%}
      {%- assign style = block.settings.style | default: 'saffron' -%}
      <a href="{{ block.settings.link | default: '#' }}" class="promo-card postcard postcard--soft promo-card--{{ style }}" {{ block.shopify_attributes }}>
        <div class="promo-card__body">
          <div class="promo-card__kicker">{{ block.settings.kicker }}</div>
          <div class="promo-card__title">{{ block.settings.title | newline_to_br }}</div>
          {%- if block.settings.cta_text != blank -%}
            <span class="promo-card__cta">{{ block.settings.cta_text }}</span>
          {%- endif -%}
        </div>
        <div class="promo-card__icon">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 200 }}" alt="" width="200" height="200" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">
          {%- else -%}
            {%- render 'icon', icon: block.settings.icon | default: 'award', size: 34 -%}
          {%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Promo Carousel",
  "tag": "section",
  "class": "section-promo",
  "max_blocks": 6,
  "settings": [],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo",
      "settings": [
        { "type": "select", "id": "style", "label": "Style", "options": [
          { "value": "saffron", "label": "Saffron" },
          { "value": "jade", "label": "Jade" },
          { "value": "gold", "label": "Gold" }
        ], "default": "saffron" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "GHARANA QUALITY" },
        { "type": "text", "id": "title", "label": "Title", "default": "Pure pantry, delivered fast." },
        { "type": "text", "id": "cta_text", "label": "CTA text", "default": "SHOP NOW" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "award", "label": "Award" }, { "value": "repeat", "label": "Subscription" },
          { "value": "truck", "label": "Delivery" }, { "value": "percent", "label": "Discount" },
          { "value": "zap", "label": "Fast" }, { "value": "shield", "label": "Trust" }
        ], "default": "award" },
        { "type": "image_picker", "id": "image", "label": "Image (optional, replaces icon)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo Carousel",
      "blocks": [
        { "type": "promo", "settings": { "style": "saffron", "kicker": "GHARANA QUALITY", "title": "Pure pantry, delivered fast.", "cta_text": "SHOP NOW", "icon": "award" } },
        { "type": "promo", "settings": { "style": "jade", "kicker": "NEVER RUN OUT", "title": "Weekly staples, sorted.", "cta_text": "SET A PLAN", "icon": "repeat" } },
        { "type": "promo", "settings": { "style": "gold", "kicker": "FIRST ORDER", "title": "₹100 off on your first box.", "cta_text": "USE FIRSTBOX", "icon": "percent" } }
      ]
    }
  ]
}
{% endschema %}
