<section class="section">
  <div class="section__head">
    <div>
      <div class="h-kicker">{{ section.settings.kicker }}</div>
      <h2 class="title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subtitle != blank -%}<div class="subtitle">{{ section.settings.subtitle }}</div>{%- endif -%}
    </div>
    <a href="{{ routes.collections_url }}" class="see-all">See all {%- render 'icon', icon: 'chevron-right', size: 14 -%}</a>
  </div>

  <div class="category-grid">
    {%- assign collection_list = section.settings.collection_list -%}
    {%- if collection_list.count > 0 -%}
      {%- for collection in collection_list -%}
        <a href="{{ collection.url }}" class="category-tile">
          <div class="category-tile__img postcard postcard--card postcard--soft" style="padding:0;">
            {%- if collection.image != blank -%}
              <img src="{{ collection.image | image_url: width: 320 }}" alt="{{ collection.title | escape }}" loading="lazy" width="320" height="320">
            {%- elsif collection.products.first.featured_image != blank -%}
              <img src="{{ collection.products.first.featured_image | image_url: width: 320 }}" alt="{{ collection.title | escape }}" loading="lazy" width="320" height="320">
            {%- else -%}
              <div style="width:100%;height:100%;background:var(--color-cream-deep);display:grid;place-items:center;color:var(--color-dust);font-size:12px;">Gharana</div>
            {%- endif -%}
          </div>
          <div class="category-tile__name">{{ collection.title }}</div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for collection in collections limit: 8 -%}
        {%- unless collection.handle == 'frontpage' -%}
          <a href="{{ collection.url }}" class="category-tile">
            <div class="category-tile__img postcard postcard--card postcard--soft" style="padding:0;">
              {%- if collection.image != blank -%}
                <img src="{{ collection.image | image_url: width: 320 }}" alt="{{ collection.title | escape }}" loading="lazy" width="320" height="320">
              {%- elsif collection.products.first.featured_image != blank -%}
                <img src="{{ collection.products.first.featured_image | image_url: width: 320 }}" alt="{{ collection.title | escape }}" loading="lazy" width="320" height="320">
              {%- else -%}
                <div style="width:100%;height:100%;background:var(--color-cream-deep);"></div>
              {%- endif -%}
            </div>
            <div class="category-tile__name">{{ collection.title }}</div>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<div class="divider-motif" aria-hidden="true"></div>

{% schema %}
{
  "name": "Category Grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "SHOP" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "From atta to spices, sourced with care" },
    { "type": "collection_list", "id": "collection_list", "label": "Select categories", "limit": 16 }
  ],
  "presets": [
    { "name": "Category Grid" }
  ]
}
{% endschema %}
