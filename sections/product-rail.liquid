<section class="section">
  <div class="section__head">
    <div>
      {%- if section.settings.kicker != blank -%}<div class="h-kicker">{{ section.settings.kicker }}</div>{%- endif -%}
      <h2 class="title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subtitle != blank -%}<div class="subtitle">{{ section.settings.subtitle }}</div>{%- endif -%}
    </div>
    {%- if section.settings.collection != blank -%}
      <a href="{{ section.settings.collection.url }}" class="see-all">See all {%- render 'icon', icon: 'chevron-right', size: 14 -%}</a>
    {%- endif -%}
  </div>

  {%- liquid
    assign products = section.settings.collection.products | default: false
    assign display = section.settings.display | default: 'rail'
    assign limit = section.settings.product_count | default: 10
  -%}

  {%- if products -%}
    {%- if display == 'grid' -%}
      <div class="product-grid">
        {%- for product in products limit: limit -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="product-rail">
        {%- for product in products limit: limit -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="container-block" style="color:var(--color-dust);font-size:13px;">Select a collection in Theme Editor to display products.</div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product Rail",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers near you" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Loved by Gharana homes" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "select", "id": "display", "label": "Display", "options": [
      { "value": "rail", "label": "Horizontal rail" },
      { "value": "grid", "label": "Grid" }
    ], "default": "rail" },
    { "type": "range", "id": "product_count", "min": 4, "max": 20, "step": 1, "label": "Products to show", "default": 10 }
  ],
  "presets": [ { "name": "Product Rail" } ]
}
{% endschema %}
