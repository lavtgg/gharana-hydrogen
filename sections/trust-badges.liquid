<section class="section container-block">
  <div class="postcard" style="padding:28px 20px;text-align:center;">
    <div class="h-kicker" style="margin-bottom:10px;">{{ section.settings.kicker }}</div>
    <h2 style="font-family:var(--font-heading);font-size:28px;line-height:1.2;color:var(--color-earth);max-width:640px;margin:0 auto 8px;font-weight:700;">{{ section.settings.heading }}</h2>
    <p style="font-size:14px;color:var(--color-espresso);max-width:560px;margin:0 auto;line-height:1.6;">{{ section.settings.body }}</p>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:24px;max-width:640px;margin-left:auto;margin-right:auto;">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }} style="text-align:center;">
          <div style="width:56px;height:56px;border-radius:16px;background:var(--color-cream-deep);display:grid;place-items:center;margin:0 auto 8px;color:var(--color-jade);">
            {%- render 'icon', icon: block.settings.icon | default: 'shield', size: 26 -%}
          </div>
          <div style="font-family:var(--font-heading);font-weight:600;font-size:13.5px;color:var(--color-earth);">{{ block.settings.title }}</div>
          <div style="font-size:11.5px;color:var(--color-dust);margin-top:2px;line-height:1.4;">{{ block.settings.subtitle }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust Badges",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "• THE GHARANA PROMISE •" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pure. Unadulterated. Traditional." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Every grain, oil and spice is sourced from small farms, cold-pressed or stone-milled, and tested batch-by-batch. No preservatives, no shortcuts." }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "shield", "label": "Shield" }, { "value": "award", "label": "Award" },
          { "value": "check-circle", "label": "Check" }, { "value": "truck", "label": "Delivery" },
          { "value": "repeat", "label": "Return" }
        ], "default": "shield" },
        { "type": "text", "id": "title", "label": "Title", "default": "Lab tested" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Every batch" }
      ]
    }
  ],
  "presets": [
    { "name": "Trust Badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "shield", "title": "Lab tested", "subtitle": "Every batch" } },
        { "type": "badge", "settings": { "icon": "award", "title": "Traditional", "subtitle": "Stone milled" } },
        { "type": "badge", "settings": { "icon": "truck", "title": "Fast delivery", "subtitle": "At your door" } }
      ]
    }
  ]
}
{% endschema %}
